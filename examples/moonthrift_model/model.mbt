) -> SharedSlowResult raise @protocol.ProtocolError {
  let fields = value.require_struct()
  let mut result : SharedSlowResult? = None
  for field in fields {
    match field.id {
      0 => {
        if result is Some(_) {
          raise InvalidValue(
            "result SharedSlowResult contains multiple known fields",
          )
        }
        result = Some(Success(field.value.require_string()))
      }
      _ => ()
    }
  }
  match result {
    Some(value) => value
    None =>
      raise InvalidValue("result SharedSlowResult has no recognized field")
  }
}

///|
pub fn SharedSlowResult::encode_binary(
  self : SharedSlowResult,
) -> Bytes raise @protocol.ProtocolError {
  @protocol.encode_binary(self.to_thrift_value())
}

///|
pub fn SharedSlowResult::decode_binary(
  input : Bytes,
) -> SharedSlowResult raise @protocol.ProtocolError {
  SharedSlowResult::from_thrift_value(@protocol.decode_binary(input, Struct))
}

///|
pub fn SharedSlowResult::encode_compact(
  self : SharedSlowResult,
) -> Bytes raise @protocol.ProtocolError {
  @protocol.encode_compact(self.to_thrift_value())
}

///|
pub fn SharedSlowResult::decode_compact(
  input : Bytes,
) -> SharedSlowResult raise @protocol.ProtocolError {
  SharedSlowResult::from_thrift_value(@protocol.decode_compact(input, Struct))
}
