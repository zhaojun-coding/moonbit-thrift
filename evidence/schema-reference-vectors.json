  "sources": {
    "common.thrift": "namespace py common\n\ntypedef i64 AccountId\nenum Status { READY = 1, ACTIVE = 2 }\n\nstruct Record {\n  1: required AccountId id\n  2: optional string name = \"anonymous\"\n  3: optional binary data\n  4: optional map<string, list<i32>> groups\n  5: optional uuid tag\n  6: optional set<string> labels\n  7: Status state = Status.READY\n  8: optional Record child\n}\n\nexception Problem {\n  1: i32 code\n  2: string message\n}\n\nservice Base {\n  string ping(1: string message)\n}\n",
    "demo.thrift": "include \"common.thrift\"\nnamespace py demo\n\nservice Records extends common.Base {\n  common.Record echo(1: common.Record value)\n  i64 add(1: i64 a, 2: i64 b)\n  void fail(1: i32 code) throws (1: common.Problem problem)\n  oneway void notify(1: string message)\n  string slow(1: i32 delayMs)\n}\n"
  },
